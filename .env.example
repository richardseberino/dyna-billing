# ---------------- MySQL ----------------
DB_NAME=dyna_billing
DB_USER=dyna
DB_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_PORT=3306
WEB_PORT=8000

# ---------------- Dynatrace ----------------
# UUID da conta (Account Management > Identity & access management > OAuth clients mostra o "urn:dtaccount:<uuid>")
DT_ACCOUNT_UUID=
# Opcional: se vazio, usa a primeira assinatura DPS ativa da conta
DT_SUBSCRIPTION_UUID=

# Autenticação - escolha UMA das opções:
# (a) Token bearer já emitido (ex.: platform token com permissão de leitura de uso/custo da conta)
DT_BEARER_TOKEN=
# (b) OAuth client com escopos account-uac-read e account-env-read (o token é renovado automaticamente)
DT_CLIENT_ID=
DT_CLIENT_SECRET=

# true = gera dados fictícios (para testar sem credenciais)
DT_MOCK=false

# ---------------- Coleta ----------------
# Na primeira carga coleta desde o início do contrato; se a data for desconhecida, usa BACKFILL_DAYS
BACKFILL_DAYS=90
# Em cada execução reprocessa os últimos N dias (a Dynatrace consolida custos com atraso)
REFRESH_DAYS=3
COLLECT_INTERVAL_MINUTES=360

# Janela (dias) da média móvel usada no destaque, na projeção e na data de esgotamento
AVG_WINDOW_DAYS=3

# ---------------- Contrato (opcional: sobrescreve o que vem da API) ----------------
# CONTRACT_START_DATE=2026-01-01
# CONTRACT_END_DATE=2026-12-31
# CONTRACT_TOTAL_CREDITS=400000   # na moeda do contrato

# ---------------- Câmbio para Reais ----------------
# ptax  = PTAX de venda do Banco Central (atualizada pelo coletor)
# fixed = usa FX_FIXED_RATE
FX_MODE=ptax
# FX_FIXED_RATE=5.40

# ---------------- Interface web: autenticação ----------------
# Chave que assina o cookie de sessão (gere com: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=
# true quando a interface for servida por HTTPS (recomendado fora do localhost)
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=8
